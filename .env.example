# Neon PostgreSQL (app & sync worker)
DATABASE_URL=

# Neon PostgreSQL direct/unpooled URL (optional, used by drizzle-kit migrations)
DATABASE_URL_UNPOOLED=

# GitHub Personal Access Token (optional for higher rate limit in sync worker)
GITHUB_TOKEN=

# AI Providers (OpenAI-compatible fallback chain)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Admin secret required for admin mutations (POST /api/admin/session & PATCH /api/tools/[id]).
# Server fails closed (503) in all environments if unset unless ALLOW_DEV_ADMIN_BYPASS=true in non-production.
ADMIN_SECRET=

# Set to "true" ONLY for local non-production development if you intentionally skip ADMIN_SECRET (ignored in production)
ALLOW_DEV_ADMIN_BYPASS=false

# Maximum new/changed/reclassified repositories to process per sync run
SYNC_LIMIT=20

# Batch size for AI batch classification & progress grouping (default 5, allowed 1..20)
SYNC_BATCH_SIZE=5

# Reclassify existing DB tools instead of crawling new candidates: none | uncategorized | all
SYNC_RECLASSIFY=none

# Delay in milliseconds between AI classification calls/batches (default 4000)
SYNC_DELAY_MS=4000

# GitHub Search API pages per stream (default 3, allowed 1..10)
GITHUB_PAGES_PER_QUERY=3

# GitHub Search stream selection mode: rotate (default: 5 core + 7 rotated topics) | all (all 24 streams)
GITHUB_STREAM_MODE=rotate
