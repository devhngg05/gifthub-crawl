# Neon PostgreSQL (pooled connection for app & worker)
DATABASE_URL="postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Neon PostgreSQL (direct unpooled connection for drizzle-kit migrations)
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=require"

# GitHub Personal Access Token (GitHub API search, README fetch & GitHub Models)
GITHUB_TOKEN=""

# AI Providers (OpenAI-compatible)
GROQ_API_KEY=""
OPENROUTER_API_KEY=""

# Admin secret for PATCH /api/tools/[id]
ADMIN_SECRET=""

# Maximum repos classified by AI per sync run (default: 20)
SYNC_LIMIT="20"
